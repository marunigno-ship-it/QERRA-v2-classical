# =====================================================
# QerraEvaluate.action
# QERRA-v2 Classical — ROS 2 Action Interface
# =====================================================

# --- GOAL ---
# SEMEV-12 Ethical Input
string situation_text

# QERRA-HSR Physical Safety Signals (Mandatory for Robot Demos)
float32 distress_confidence
int32   persons_nearby_count
bool    hazard_proximity_flag
bool    robot_task_interruptible

---

# --- RESULT ---
# The complete ethical and safety assessment

# Risk score: 0.0 = no concern, 1.0 = critical
float32 score

# Primary decision gate: "safe" or "modified"
string decision

# Human-readable label for the score band
string score_explanation

# Full reasoning string: which vectors fired and why
string reasoning

# List of activated SEMEV-12 vector IDs e.g. ["v004", "v003"]
string[] vectors_activated

# Evaluation source (Local vs remote)
bool evaluation_source_local

# Integrity flags
bool success
string error_message

---

# --- FEEDBACK ---
# Real-time status updates published during evaluation
string status
